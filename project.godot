; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sentinela"
config/description="Proteja a Samaúma, a mãe das árvores, contra cinco ondas de ameaças à floresta."
run/main_scene="res://cenas/telas/TelaInicial.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.1, 0.075, 1)
boot_splash/stretch_mode=0
boot_splash/use_filter=false
boot_splash/image="res://assets/interface/logo.png"
config/icon="res://icon.png"

[autoload]

Balanceamento="*res://cenas/jogo/balanceamento.gd"
AudioManager="*res://cenas/audio/audio_manager.gd"
Transicao="*res://cenas/interface/transicao.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://cenas/interface/tema.tres"

